#include <iostream>
#include<fstream>

using namespace std;

int main() {
    int n;
    setlocale(LC_ALL, "russian");
    cout << "Введите размерность: ";
    cin >> n;

    double** A = new double* [n];
    for (int i = 0; i < n; i++) {
        A[i] = new double[n];
    }
    double* b = new double[n];
    double* x = new double[n];

    cout << "Введите матрицу коэффициентов" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> A[i][j];
        }
    }

    cout << "Введите вектор" << endl;
    for (int i = 0; i < n; i++) {
        cin >> b[i];
    }

    ofstream fout("result.txt");
    if (!fout.is_open()) {
        cout << "ошибка";
        return 1;
    }
    cout << "\nИсходная система:" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout << A[i][j] << " ";
        }
        cout << " | " << b[i] << endl;
    }
    cout << endl;

    for (int k = 0; k < n - 1; k++) {

        double max = A[k][k];
        if (max < 0)
            max = -max;
        int m = k;
        for (int i = k + 1; i < n; i++) {
            double val = A[i][k];
            if (val < 0)
                val = -val;
            if (val > max) {
                max = val;
                m = i;
            }
        }
        if (max == 0) {
            cout << "ошибка";
            return 1;
        }
        if (m != k) {
            for (int j = 0; j < n; j++) {
                double temp = A[k][j];
                A[k][j] = A[m][j];
                A[m][j] = temp;
            }
            double temp = b[k];
            b[k] = b[m];
            b[m] = temp;
        }

        for (int i = k + 1; i < n; i++) {
            double t = A[i][k] / A[k][k];
            b[i] = b[i] - t * b[k];
            for (int j = k + 1; j < n; j++) {
                A[i][j] = A[i][j] - t * A[k][j];
            }
            A[i][k] = 0;
        }
    }

    x[n - 1] = b[n - 1] / A[n - 1][n - 1];
    for (int k = n - 2; k >= 0; k--) {
        double sum = 0;
        for (int j = k + 1; j < n; j++) {
            sum += A[k][j] * x[j];
        }
        x[k] = (b[k] - sum) / A[k][k];
    }

    cout << "Решение:" << endl;
    for (int i = 0; i < n; i++) {
        cout << x[i]<< endl;
    }

    for (int i = 0; i < n; i++) {
        delete[] A[i];
    }
    delete[] A;
    delete[] b;
    delete[] x;

    return 0;
}
